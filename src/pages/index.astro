---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Reverse-engineer your strongest marketing lane from your experience, proof, interests, and target outcome." />
    <title>Find Your Marketing Lane</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="logo-mark" href="/" aria-label="Find Your Marketing Lane">
          <img src="/images/columbus-marketing-logo.svg" alt="Columbus Marketing" />
        </a>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">Find Your Marketing Lane</p>
          <h1>Turn your <span class="messy-word">messy</span> experience into a <span class="clear-word">clear</span> marketing direction.</h1>
          <p class="lead">
            You do not need to know your niche yet. This tool reverse-engineers it from your work history, proof, interests, and the outcome you want next.
          </p>
        </div>
      </section>

      <section class="app" aria-label="Marketing lane finder">
        <div class="progress">
          <span id="stepLabel">Step 1 of 6</span>
          <div><i id="progressBar"></i></div>
        </div>

        <form id="laneForm">
          <section class="step is-active" data-step="0">
            <h2>What are you trying to land?</h2>
            <p>Start with the outcome you want most. The next questions will pull a clear lane from your actual experience.</p>
            <div class="choice-grid">
              <label class="choice">
                <input type="radio" name="path" value="job" checked />
                <span>Marketing job offer</span>
                <small>Target role, LinkedIn positioning, interview angle.</small>
              </label>
              <label class="choice">
                <input type="radio" name="path" value="freelance" />
                <span>First freelance customer</span>
                <small>Buyer, problem, offer, outreach angle.</small>
              </label>
            </div>
          </section>

          <section class="step" data-step="1">
            <h2>What have you already been around?</h2>
            <p>Do not polish this. List the roles, industries, teams, and audiences you have touched.</p>
            <label>Roles or responsibilities<textarea name="roles" placeholder="Content coordinator, email campaigns, marketing ops, social media, sales enablement..."></textarea></label>
            <label>Industries or company types<textarea name="industries" placeholder="Healthcare, SaaS, nonprofits, local services, education, agencies..."></textarea></label>
            <label>Audiences you understand<textarea name="audiences" placeholder="Founders, sales teams, patients, students, HR leaders, small business owners..."></textarea></label>
          </section>

          <section class="step" data-step="2">
            <h2>Where is there proof?</h2>
            <p>Small proof counts. We are looking for before-and-after stories.</p>
            <label>Best outcomes you helped create<textarea name="wins" placeholder="Increased replies, launched a campaign, improved onboarding, clarified messaging, grew traffic..."></textarea></label>
            <label>Problems people ask you to help with<textarea name="asks" placeholder="Writing, organizing campaigns, making LinkedIn better, finding insights, building pages..."></textarea></label>
          </section>

          <section class="step" data-step="3">
            <h2>What work gives you energy?</h2>
            <p>Your lane has to be repeatable. Pick the work you can keep doing.</p>
            <fieldset class="tag-grid" id="tactics">
              <label><input type="checkbox" value="content" /> Content</label>
              <label><input type="checkbox" value="email" /> Email</label>
              <label><input type="checkbox" value="analytics" /> Analytics</label>
              <label><input type="checkbox" value="brand" /> Brand</label>
              <label><input type="checkbox" value="paid" /> Paid ads</label>
              <label><input type="checkbox" value="web" /> Websites</label>
              <label><input type="checkbox" value="community" /> Community</label>
              <label><input type="checkbox" value="ops" /> Marketing ops</label>
            </fieldset>
            <label>Work you want less of<textarea name="avoid" placeholder="Anything that drains you or feels like the wrong lane."></textarea></label>
          </section>

          <section class="step" data-step="4">
            <h2>What sounds interesting enough to explore?</h2>
            <p>You are reacting now, not inventing from scratch.</p>
            <label>Companies, categories, or problems you are curious about<textarea name="curiosity" placeholder="Founder-led companies, underdog nonprofits, healthcare access, boring B2B, local businesses..."></textarea></label>
            <label>Optional: target role or buyer you already suspect<textarea name="suspect" placeholder="Lifecycle marketer, content strategist, clinic owner, B2B founder..."></textarea></label>
          </section>

          <section class="step" data-step="5">
            <h2>Your lane recommendations</h2>
            <p>These are starting points. Pick the one that feels both credible and alive.</p>
            <div id="results" class="results" aria-live="polite"></div>
          </section>

          <div class="actions">
            <button type="button" id="backBtn" class="btn btn-ghost">Back</button>
            <button type="button" id="nextBtn" class="btn btn-primary">Next</button>
          </div>
        </form>
      </section>
    </main>

    <script>
      const steps = [...document.querySelectorAll(".step")];
      const nextBtn = document.querySelector("#nextBtn");
      const backBtn = document.querySelector("#backBtn");
      const stepLabel = document.querySelector("#stepLabel");
      const progressBar = document.querySelector("#progressBar");
      const results = document.querySelector("#results");
      let current = 0;

      const tacticMap = {
        content: ["content strategist", "founder-led content", "turn expertise into useful posts"],
        email: ["lifecycle marketer", "email onboarding", "move people from interest to action"],
        analytics: ["growth analyst", "measurement and reporting", "find what is actually working"],
        brand: ["brand marketer", "positioning and messaging", "make the value easier to understand"],
        paid: ["paid acquisition marketer", "campaign testing", "turn spend into learning"],
        web: ["conversion marketer", "landing pages", "turn traffic into leads"],
        community: ["community marketer", "events and engagement", "create useful connection"],
        ops: ["marketing ops specialist", "systems and workflows", "make marketing repeatable"]
      };

      function words(value) {
        return (value || "")
          .toLowerCase()
          .split(/[^a-z0-9]+/)
          .filter(Boolean)
          .filter((w) => w.length > 2);
      }

      function field(name) {
        return new FormData(document.querySelector("#laneForm")).get(name)?.toString().trim() || "";
      }

      function selectedTactics() {
        return [...document.querySelectorAll("#tactics input:checked")].map((input) => input.value);
      }

      function phrase(source, fallback) {
        const chunks = source.split(/[,.;\n]/).map((x) => x.trim()).filter(Boolean);
        return chunks[0] || fallback;
      }

      function cleanAudience(value) {
        return (value || "")
          .replace(/\b(i|we)\s+(worked with|work with|helped|help|served|marketed to|sold to|supported)\s+/gi, "")
          .replace(/\b(my|our)\s+/gi, "")
          .replace(/\b(in|at|for)\s+$/gi, "")
          .replace(/\.$/, "")
          .trim();
      }

      function audienceCandidates(source) {
        return (source || "")
          .split(/[,;\n]/)
          .map((item) => cleanAudience(item))
          .filter(Boolean)
          .filter((item) => !/^(i|we)\b/i.test(item));
      }

      function audienceLabel(source, fallback) {
        const candidates = audienceCandidates(source);
        const preferred = candidates.find((item) => /\b(teams|companies|businesses|owners|founders|leaders|marketers|clinics|agencies|startups|nonprofits|brands|creators)\b/i.test(item));
        let base = preferred || candidates[0] || fallback;
        base = base
          .replace(/^(.+?)\s+marketers\s+in\s+B2B$/i, "B2B $1 marketers")
          .replace(/^(.+?)\s+teams\s+in\s+B2B$/i, "B2B $1 teams")
          .replace(/\s+/g, " ")
          .trim();
        return /\b(teams|companies|businesses|owners|founders|leaders|marketers|clinics|agencies)\b/i.test(base)
          ? base
          : `${base} teams`;
      }

      function lowerAudience(value) {
        return value
          .replace(/\bB2B\b/gi, "__B2B__")
          .replace(/\bSaaS\b/gi, "__SAAS__")
          .toLowerCase()
          .replace(/__b2b__/gi, "B2B")
          .replace(/__saas__/gi, "SaaS");
      }

      function cleanFragment(value, fallback) {
        return phrase(value, fallback)
          .replace(/^(i|we)\s+(helped|help|did|created|made|worked on)\s+/i, "")
          .replace(/\.$/, "")
          .trim();
      }

      function naturalOutcome(value, fallback) {
        let fragment = cleanFragment(value, fallback).toLowerCase();
        const verbFixes = [
          ["increased", "increase"],
          ["improved", "improve"],
          ["clarified", "clarify"],
          ["launched", "launch"],
          ["grew", "grow"],
          ["built", "build"],
          ["shipped", "ship"],
          ["created", "create"],
          ["generated", "generate"],
          ["organized", "organize"],
          ["reduced", "reduce"]
        ];
        for (const [past, present] of verbFixes) {
          if (fragment.startsWith(`${past} `)) fragment = fragment.replace(past, present);
        }
        if (/^(increase|decrease|launch|clarify|improve|grow|build|ship|turn|move|find|make|create)\b/.test(fragment)) {
          return fragment;
        }
        return `improve ${fragment}`;
      }

      function naturalProblem(value, fallback) {
        const fragment = cleanFragment(value, fallback).toLowerCase();
        if (/^(with|around|on)\b/.test(fragment)) return fragment.replace(/^(with|around|on)\s+/i, "");
        return fragment;
      }

      function scoreNote(label, value) {
        if (label === "Legible") return `${value}% - clear enough for a stranger to understand quickly`;
        if (label === "Compelling") return `${value}% - connected to a problem people are likely to care about`;
        return `${value}% - anchored in experience, interests, or proof that can make the lane feel specific`;
      }

      function scoreLane(lane, data) {
        const haystack = words(`${data.roles} ${data.industries} ${data.audiences} ${data.wins} ${data.asks} ${data.curiosity} ${data.suspect}`);
        const laneWords = words(`${lane.role} ${lane.audience} ${lane.problem} ${lane.outcome}`);
        const overlap = laneWords.filter((w) => haystack.includes(w)).length;
        return {
          legible: Math.min(96, 66 + overlap * 5 + (data.wins ? 8 : 0)),
          compelling: Math.min(96, 62 + (data.asks ? 12 : 0) + (data.curiosity ? 8 : 0)),
          differentiated: Math.min(96, 58 + (data.industries ? 12 : 0) + (data.audiences ? 8 : 0) + selectedTactics().length * 2)
        };
      }

      function opportunityStrategy(path, lane, data, tactics) {
        const audience = lowerAudience(lane.audience);
        const hasWarmSignals = Boolean(data.audiences || data.industries || data.suspect);
        const proofAsset = tactics.includes("web") || tactics.includes("brand")
          ? "a quick teardown or mini-audit"
          : tactics.includes("content")
            ? "a short point-of-view post or content sample"
            : "a simple proof asset";

        if (path === "freelance") {
          if (tactics.includes("web") || tactics.includes("brand")) {
            return {
              title: "Best first-client path: mini-audit outreach",
              why: `This lane is easiest to sell when the buyer can see the problem. Create ${proofAsset} for ${audience}, then send it as useful proof before asking for a call.`,
              steps: [
                `Build a list of 25 ${audience}.`,
                `Record or write one specific audit showing what is unclear and what to fix first.`,
                `Send 5 warm or lightly personalized messages per day with the audit as the value-first reason to reply.`
              ]
            };
          }
          if (hasWarmSignals) {
            return {
              title: "Best first-client path: warm referral ask",
              why: `Your inputs show some existing context around ${audience}. Start with people who already trust you, then ask for introductions before doing colder outreach.`,
              steps: [
                "List 20 people who know your work or understand this market.",
                `Ask who they know at ${audience} that might want help with ${lane.problem}.`,
                "Follow up with a simple starter offer, not a vague request to network."
              ]
            };
          }
          return {
            title: "Best first-client path: focused cold outreach",
            why: `This lane needs signal. Use a narrow list, a concrete problem, and a small first offer instead of broad “marketing help.”`,
            steps: [
              `Find 50 ${audience} with visible signs of the problem.`,
              `Send a short message naming one likely issue and offering ${proofAsset}.`,
              "Track replies and refine the offer after every 10 messages."
            ]
          };
        }

        if (hasWarmSignals) {
          return {
            title: "Best job-search path: warm-intro target list",
            why: `This lane is stronger if you turn your existing context into conversations. Do not start with job boards. Start with people adjacent to ${audience}.`,
            steps: [
              `Build a list of 30 companies or teams that look like ${audience}.`,
              "Find the marketing lead, hiring manager, or mutual connection.",
              `Ask for a 15-minute conversation about how they approach ${lane.problem}, then share your proof asset.`
            ]
          };
        }

        return {
          title: "Best job-search path: proof-led hiring-manager outreach",
          why: `If you do not have a warm path yet, lead with evidence. A small case study or teardown gives a hiring manager a reason to pay attention.`,
          steps: [
            `Create one proof asset tied to ${lane.problem}.`,
            "Apply only after you have also found the likely hiring manager.",
            "Send a short note with the proof asset and ask for feedback, not a job."
          ]
        };
      }

      function buildLanes() {
        const path = field("path");
        const data = {
          roles: field("roles"),
          industries: field("industries"),
          audiences: field("audiences"),
          wins: field("wins"),
          asks: field("asks"),
          curiosity: field("curiosity"),
          suspect: field("suspect")
        };
        const tactics = selectedTactics();
        const baseAudience = audienceLabel(`${data.audiences}\n${data.industries}\n${data.curiosity}`, path === "job" ? "growing marketing teams" : "founder-led businesses");
        const proof = naturalOutcome(data.wins || data.asks, "make marketing easier to understand and act on");
        const seeds = tactics.length ? tactics : ["content", "web", "email"];
        const lanes = seeds.slice(0, 4).map((key) => {
          const [role, problem, outcome] = tacticMap[key];
          const naturalOffer = path === "job"
            ? `Position yourself as a ${role} for ${lowerAudience(baseAudience)}, with proof that you can ${proof}.`
            : `Offer a focused ${problem} sprint for ${lowerAudience(baseAudience)} that helps them ${outcome}.`;
          const lane = {
            role,
            audience: baseAudience,
            problem,
            outcome,
            statement: path === "job"
              ? `A ${role} helping ${lowerAudience(baseAudience)} ${outcome}.`
              : `Help ${lowerAudience(baseAudience)} with ${problem} so they can ${outcome}.`,
            asset: naturalOffer,
            nextStep: path === "job"
              ? `Turn this into a LinkedIn headline, About opener, target role list, and case study angle.`
              : `Turn this into a simple paid offer, proof asset, first DM, and 10 target buyers.`
          };
          return { ...lane, strategy: opportunityStrategy(path, lane, data, tactics) };
        });

        if (data.suspect) {
          const suspectedProblem = naturalProblem(data.asks || data.curiosity, "a clear marketing bottleneck");
          const suspectedLane = {
            role: path === "job" ? data.suspect : "specialist",
            audience: baseAudience,
            problem: suspectedProblem,
            outcome: proof,
            statement: path === "job"
              ? `Target ${data.suspect} roles where you can help ${lowerAudience(baseAudience)} ${proof}.`
              : `Help ${lowerAudience(baseAudience)} ${proof} without making marketing feel heavier.`,
            asset: path === "job"
              ? `Your strongest angle is not just the title. It is the overlap between ${data.suspect}, ${lowerAudience(baseAudience)}, and your proof around ${proof}.`
              : `Your starter offer should make the first step feel concrete: diagnose ${suspectedProblem}, make one useful improvement, and show the buyer what to do next.`,
            nextStep: path === "job"
              ? `Turn this into three target-role versions and a sharper proof story.`
              : `Turn this into three offer names, a scope, and a first outreach message.`
          };
          lanes.unshift({ ...suspectedLane, strategy: opportunityStrategy(path, suspectedLane, data, tactics) });
        }

        return lanes.slice(0, 5).map((lane) => ({ ...lane, score: scoreLane(lane, data), data, path }));
      }

      function renderResults() {
        const lanes = buildLanes();
        results.innerHTML = lanes.map((lane, index) => {
          const total = Math.round((lane.score.legible + lane.score.compelling + lane.score.differentiated) / 3);
          const prompt = buildPrompt(lane, total);
          return `
            <article class="lane-card">
              <div class="lane-card__head">
                <span>Lane ${index + 1}</span>
                <strong>${total}% fit</strong>
              </div>
              <h3>${lane.statement}</h3>
              <p>${lane.asset}</p>
              <p class="lane-card__next">${lane.nextStep}</p>
              ${strategyBlock(lane.strategy)}
              <div class="meters">
                ${meter("Legible", lane.score.legible, scoreNote("Legible", lane.score.legible))}
                ${meter("Compelling", lane.score.compelling, scoreNote("Compelling", lane.score.compelling))}
                ${meter("Differentiated", lane.score.differentiated, scoreNote("Differentiated", lane.score.differentiated))}
              </div>
              <button type="button" class="copy-btn" data-copy="${encodeURIComponent(prompt)}">Copy LLM prompt</button>
            </article>
          `;
        }).join("");
        document.querySelectorAll(".copy-btn").forEach((button) => {
          button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(decodeURIComponent(button.dataset.copy));
            button.textContent = "Copied";
          });
        });
      }

      function meter(label, value, note) {
        return `<div class="meter"><div class="meter__copy"><span>${label}</span><em>${note}</em></div><div class="meter__track"><b style="width:${value}%"></b></div></div>`;
      }

      function strategyBlock(strategy) {
        return `<div class="strategy">
          <strong>${strategy.title}</strong>
          <p>${strategy.why}</p>
          <ol>${strategy.steps.map((step) => `<li>${step}</li>`).join("")}</ol>
        </div>`;
      }

      function buildPrompt(lane, total) {
        const data = lane.data;
        return `Act as a practical positioning strategist for an early-career marketer.

I used a tool called Find Your Marketing Lane. Help me expand and sharpen this lane so I can decide whether to use it for my ${lane.path === "job" ? "job search" : "first freelance offer"}.

Recommended lane:
${lane.statement}

Natural-language angle:
${lane.asset}

Suggested next step:
${lane.nextStep}

Recommended opportunity strategy:
${lane.strategy.title}
Why this strategy fits:
${lane.strategy.why}
First actions:
${lane.strategy.steps.map((step, index) => `${index + 1}. ${step}`).join("\n")}

Scores:
- Overall fit: ${total}%
- Legible: ${scoreNote("Legible", lane.score.legible)}
- Compelling: ${scoreNote("Compelling", lane.score.compelling)}
- Differentiated: ${scoreNote("Differentiated", lane.score.differentiated)}

My raw inputs:
- Roles or responsibilities: ${data.roles || "Not provided"}
- Industries or company types: ${data.industries || "Not provided"}
- Audiences I understand: ${data.audiences || "Not provided"}
- Best outcomes I helped create: ${data.wins || "Not provided"}
- Problems people ask me to help with: ${data.asks || "Not provided"}
- Companies, categories, or problems I am curious about: ${data.curiosity || "Not provided"}
- Target role or buyer I suspect: ${data.suspect || "Not provided"}
- Tactics I selected: ${selectedTactics().join(", ") || "Not provided"}
- Work I want less of: ${field("avoid") || "Not provided"}

Please help me:
1. Rewrite this lane in clearer, more natural language.
2. Give me 5 sharper niche options that are more specific but not too narrow.
3. Explain which option is most legible, most compelling, and most differentiated.
4. Suggest the first proof asset or case study I should build.
5. Suggest a LinkedIn headline and About opener.
6. If this is a freelance lane, suggest a simple starter offer with scope, promise, and first outreach message.
7. Build on the recommended opportunity strategy and give me a 7-day action plan.
8. If this is a job-search lane, suggest target role titles, company types, and a first networking message.
9. Ask me 5 follow-up questions that would help you refine the lane further.`;
      }

      function showStep(next) {
        current = Math.max(0, Math.min(steps.length - 1, next));
        steps.forEach((step, index) => step.classList.toggle("is-active", index === current));
        backBtn.style.visibility = current === 0 ? "hidden" : "visible";
        nextBtn.textContent = current === steps.length - 2 ? "Generate lanes" : current === steps.length - 1 ? "Start over" : "Next";
        stepLabel.textContent = `Step ${current + 1} of ${steps.length}`;
        progressBar.style.width = `${((current + 1) / steps.length) * 100}%`;
        if (current === steps.length - 1) renderResults();
      }

      nextBtn.addEventListener("click", () => {
        if (current === steps.length - 1) {
          document.querySelector("#laneForm").reset();
          showStep(0);
          return;
        }
        showStep(current + 1);
      });
      backBtn.addEventListener("click", () => showStep(current - 1));
      showStep(0);
    </script>
  </body>
</html>
